###  https://w3id.org/FAIR-course-UT/2026-2027/group6/ont#containedInPlace
:containedInPlace rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :City ;
                  rdfs:range :Country .


###  https://w3id.org/FAIR-course-UT/2026-2027/group6/ont#hasFeatureOfInterest
:hasFeatureOfInterest rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Observation ;
                      rdfs:range :City .


